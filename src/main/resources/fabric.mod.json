{
	"schemaVersion": 1,
	"id": "rkbclient",
	"version": "${version}",
	"name": "RKB Client",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"RKB_GAMERZ"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/rkbclient/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.rkb.client.RKBClient"
		],
		"client": [
			"com.rkb.client.RKBClientClient"
		]
	},
	"mixins": [
		"rkbclient.mixins.json",
		{
			"config": "rkbclient.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}